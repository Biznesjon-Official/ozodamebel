# Production Environment Variables
# Copy this file to .env on your production server and fill in the values

# Environment
NODE_ENV=production

# Server Configuration
PORT=3008
FRONTEND_URL=https://ozoda.biznesjon.uz
ADMIN_URL=https://admin.ozoda.biznesjon.uz

# Database - MongoDB Atlas (Recommended)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/furniture_crm?retryWrites=true&w=majority
# Or Local MongoDB:
# MONGODB_URI=mongodb://admin:password@localhost:27017/furniture_crm?authSource=admin

# JWT Configuration (MUST BE CHANGED!)
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MINIMUM_32_CHARACTERS_LONG
JWT_EXPIRE=30d

# SMS Configuration (Eskiz.uz)
SMS_API_URL=https://notify.eskiz.uz/api
SMS_API_TOKEN=your_production_sms_api_token_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_production_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_production_telegram_chat_id_here

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://localhost:6379

# MongoDB Docker Configuration (if using Docker)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
MONGO_DB_NAME=furniture_crm

# Email Configuration (Optional - for future features)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
